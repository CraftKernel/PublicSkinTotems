{
  "schemaVersion": 1,
  "id": "publicskintotems",
  "version": "${version}",
  "name": "PublicSkinTotems",
  "description": "Renders claimed Totems of Undying as 3D figures wearing the owner's skin. Pick up a plain totem and it locks to your skin automatically; totems claimed by other players keep their skin, so everyone can see whose totem is whose.",
  "authors": ["CraftKernel"],
  "contact": {},
  "license": "Apache-2.0",
  "icon": "assets/publicskintotems/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["github.com.CraftKernel.publicskintotems.Publicskintotems"],
    "client": ["github.com.CraftKernel.publicskintotems.client.PublicskintotemsClient"]
  },
  "mixins": [
    {
      "config": "publicskintotems.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${mc_range}"
  }
}
